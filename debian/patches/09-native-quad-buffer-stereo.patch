+static float stereoValue ( const char *name, float fallback )
+{
+  const char *text = getenv ( name ) ;
+  if ( text == NULL ) return fallback ;
+  char *end ;
+  double value = strtod ( text, &end ) ;
+  if ( end == text || *end != '\0' || !(value > 0.0 && value < 1.0e6) )
+    return fallback ;
+  return (float) value ;
+}
