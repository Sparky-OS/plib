+    _ssgCurrentContext->loadModelviewMatrix () ;
+    _ssgCurrentContext->applyClipPlanes () ;
 
-  _ssgCurrentContext->removeClipPlanes () ;
+    for ( i = 0 ; i < 8 ; i++ )
+      if ( ! _ssgLights [ i ] . isHeadlight () )
