+                (strcmp ( enabled, "ON" ) == 0 || strcmp ( enabled, "1" ) == 0) &&
+                !_ssgCurrentContext->isOrtho () ;
+  if ( stereo )
+  {
+    glGetBooleanv ( GL_STEREO, &available ) ;
+    glGetIntegerv ( GL_DRAW_BUFFER, &drawBuffer ) ;
+    stereo = available && drawBuffer == GL_BACK ;
+  }
+
+  sgMat4 camera ;
+  _ssgCurrentContext->getModelviewMatrix ( camera ) ;
+  sgFrustum frustum = *_ssgCurrentContext->getFrustum () ;
+  float separation = stereoValue ( "PLIB_SSG_EYE_SEPARATION", 0.065f ) ;
+  float convergence = stereoValue ( "PLIB_SSG_CONVERGENCE", 10.0f ) ;
 
-  ssgForceBasicState () ;
+  for ( int eye = 0 ; eye < (stereo ? 2 : 1) ; eye++ )
+  {
+    float offset = stereo ? (eye == 0 ? -0.5f : 0.5f) * separation : 0.0f ;
+    if ( stereo )
+    {
+      sgCopyMat4 ( _ssgCurrentContext->cameraMatrix, camera ) ;
+      _ssgCurrentContext->cameraMatrix[3][0] -= offset ;
+      float shift = -offset * frustum.getNear () / convergence ;
+      _ssgCurrentContext->setFrustum ( frustum.getLeft () + shift,
+                                     frustum.getRight () + shift,
+                                     frustum.getBot (), frustum.getTop (),
+                                     frustum.getNear (), frustum.getFar () ) ;
